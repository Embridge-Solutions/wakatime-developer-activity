# Node dependencies
node_modules/

# Environment variables (keep only a template without secrets)
.env
.env.*
!.env.example
env.txt

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
*.log

# Server logs (daily server-YYYY-MM-DD.log files)
server-logs/
logs/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp

# Dist build folders
dist/
build/
out/

# Coverage reports
coverage/

# Temporary files
tmp/
temp/

# Sequelize migrations cache if used
.sequelize/

# TypeScript cache
*.tsbuildinfo

# PM2 logs
.pids
*.pid

# Optional: ignore uploads folder
uploads/
public/uploads/

# Optional: ignore backups
backup/

# Runtime data written by the app (mail history / mail settings saved from the UI)
data/mail-logs.json
data/mail-settings.json
